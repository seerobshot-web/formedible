NEXT_PUBLIC_SERVER_URL=

# Kingdom Query (survey tool) -- Supabase project credentials.
# Safe to expose in the browser: the anon key only works within the RLS
# policies defined in supabase/migrations/0001_kingdom_query.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-side only, used by scripts/seed-kingdom-query.ts.
# NEVER prefix this with NEXT_PUBLIC_ or ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Email of the account the demo survey should be owned by (must already
# exist in Supabase Auth -- sign up once at /kingdom-query/login first).
KINGDOM_QUERY_SEED_OWNER_EMAIL=